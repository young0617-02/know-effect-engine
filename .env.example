# 复制为 .env 后按需覆盖；所有键以 KEE_ 为前缀
# 本地模型权重（本机既有目录，不下载）
KEE_BGE_M3_PATH=D:/modelscope/hub/models/BAAI--bge-m3/snapshots/master
KEE_BGE_RERANKER_PATH=D:/modelscope/hub/models/BAAI--bge-reranker-v2-m3/snapshots/master

# PDF 解析后端：auto=pypdf 文本层优先、文本层薄则转本地 MinerU-ONNX（版面+OCR）
# 可选 pypdf（只用文本层）/ mineru_onnx（强制版面+OCR）
KEE_PDF_PARSE_BACKEND=auto
KEE_MINERU_MODEL_DIR=D:/modelscope/hub/models/MinerU-4_models_onnx
KEE_OCR_DPI=150
KEE_PDF_MIN_CHARS_PER_PAGE=40

# 存储栈（对应 infra/docker-compose.gate0.yml 的宿主映射端口）
KEE_MILVUS_URI=http://127.0.0.1:39530
KEE_MILVUS_DB=default
KEE_POSTGRES_DSN=postgresql://kee_app:待填_KEE_PG_APP_PASSWORD@127.0.0.1:35432/kee
KEE_REDIS_URL=redis://127.0.0.1:36379/0

# 生成模型（本地优先，数据不出域）
KEE_OLLAMA_URL=http://127.0.0.1:11434
KEE_LLM_MODEL=qwen2.5:7b
KEE_LLM_KEEP_ALIVE=-1s

# 云端兜底：Gate 0 阶段一律关闭（数据不出域验证需要）
KEE_CLOUD_FALLBACK_ENABLED=false

# 入库期 VLM（图片/图表描述索引）。默认关闭；只在建索引时调用，服务时不用 VLM。
# 本地推荐：vLLM 起 Qwen3-VL-8B-Instruct（OpenAI 兼容），base_url 指向回环地址。
# 云端测试：把 base_url 换成供应商的 OpenAI 兼容地址，并显式设 KEE_VLM_ALLOW_REMOTE=true
#           —— 这等于承认图片与描述提示会离开本机；生产交付必须关掉或换回本地。
KEE_VLM_ENABLED=false
KEE_VLM_BASE_URL=http://127.0.0.1:8000/v1
KEE_VLM_MODEL=Qwen3-VL-8B-Instruct
KEE_VLM_API_KEY=
KEE_VLM_TIMEOUT_SEC=60
KEE_VLM_MAX_TOKENS=512
KEE_VLM_ALLOW_REMOTE=false
KEE_VLM_MAX_IMAGES_PER_DOC=20
# 小于此像素数的图片只 OCR、不送 VLM；PDF 图表区域另有面积比与每页上限两道闸
KEE_VLM_MIN_IMAGE_PIXELS=20000
KEE_VLM_MIN_FIGURE_AREA_RATIO=0.01
KEE_VLM_MAX_FIGURES_PER_PAGE=6
KEE_VLM_FAIL_FAST_AFTER=2
# 文本层够厚的 PDF 仍抽取内嵌图片做 OCR/VLM；关掉它可让纯文本 PDF 完全不碰图片
KEE_MEDIA_SCAN_TEXT_PDF=true

# 公式识别：使用本地 PP-FormulaNet_plus-M ONNX；空路径=标准相对路径
KEE_PARSE_FORMULA=true
KEE_FORMULA_MODEL_PATH=

# 可观测（Prometheus 指标 / 结构化日志 / Langfuse 上报）
# /metrics 暴露的全是闭合枚举标签的计数与直方图：没有查询文本、没有用户名、没有文档 id。
# 两道结构性收口：API 只绑回环（serve_api.py 明文拒绝非回环绑定）+ Nginx 不反代该路径。
# 要彻底关掉就设 false，那时 /metrics 返回 404，指标层仍在计数但没人取得到。
KEE_METRICS_ENABLED=true
KEE_LOG_LEVEL=INFO
KEE_LOG_JSON=true

# Langfuse **一律自托管**，默认关闭。上报载荷含问题与结论原文，所以目标地址必须是回环或私网
# （`src/kee/obs/langfuse.py:in_domain_host`）；公网目标要显式开 ALLOW_REMOTE 才放行，
# 而开它等于书面承认数据出域，风险登记要跟上。
# pk/sk 只写在这里（`.env` 已 gitignore）——不要提交进任何入库文件。
KEE_LANGFUSE_ENABLED=false
KEE_LANGFUSE_HOST=http://127.0.0.1:30090
KEE_LANGFUSE_PUBLIC_KEY=
KEE_LANGFUSE_SECRET_KEY=
KEE_LANGFUSE_FLUSH_INTERVAL_SEC=2
KEE_LANGFUSE_MAX_BATCH=50
KEE_LANGFUSE_TIMEOUT_SEC=5
KEE_LANGFUSE_ALLOW_REMOTE=false

# 运行目录
KEE_ARTIFACT_DIR=var/gate0
