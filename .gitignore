# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# 本地依赖与模型缓存
# 注意用 /models/ 而非 models/：后者会连 src/kee/models 这个源码包一起忽略掉
/models/
*.gguf
*.onnx
*.safetensors

# 数据与运行态（含客户资料，不入库）
data/
var/*
backups/

# 证据产物必须入库：三份报告（Gate 0 / M1 / M2）都把 var/gate0/*.json 写成「原始证据」，
# 若整个 var/ 被忽略，克隆仓库的人拿到的报告其引用证据一个都不在树里，"可复跑核对"就落空。
# 只纳入判定与指标本身（JSON/JSONL/CSV，合计约 440K）：
!var/gate0/
var/gate0/*
!var/gate0/*.json
!var/gate0/*.jsonl
!var/gate0/*.csv
# 继续排除：向量物料与重建备份可由权威源重建；fixtures 含真实厂商 PDF 的衍生物，不入库
*.log

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem

# 构建与前端
dist/
build/
node_modules/

# 编辑器与系统
.idea/
.vscode/
Thumbs.db
Desktop.ini
