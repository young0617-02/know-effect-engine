# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# 本地依赖与模型缓存
# 注意用 /models/ 而非 models/：后者会连 src/kee/models 这个源码包一起忽略掉
/models/
*.gguf
*.onnx
*.safetensors

# 数据与运行态（含客户资料，不入库）
data/
var/*
backups/

# 证据产物必须入库：三份报告（Gate 0 / M1 / M2）都把 var/gate0/*.json 写成「原始证据」，
# 若整个 var/ 被忽略，克隆仓库的人拿到的报告其引用证据一个都不在树里，"可复跑核对"就落空。
# 只纳入判定与指标本身（JSON/JSONL/CSV；现合计约 1.1M，其中 355K 是第二人标注工单
# annotations_a2_fill.csv——它是待填的输入，不是结果，填完才算证据）：
!var/gate0/
var/gate0/*
!var/gate0/*.json
!var/gate0/*.jsonl
!var/gate0/*.csv
# 继续排除：向量物料与重建备份可由权威源重建；fixtures 含真实厂商 PDF 的衍生物，不入库；
# annotations_a2_worksheet.md 也不入库——它是那份 CSV 的人读渲染，可由脚本随时重生成，
# 存进来只会造成「改了一处忘了另一处」的漂移。
*.log

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem

# 构建与前端
dist/
build/
node_modules/

# 编辑器与系统
.idea/
.vscode/
Thumbs.db
Desktop.ini

# 真机验证通路（playwright-cli）的控制台日志与临时产物，纯本机 scratch
.playwright-cli/
